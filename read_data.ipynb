    "        (f_cut,  psd_sx_cut,  \"SX Tagliato/Finestrato\", \"darkblue\"),\n",
    "        (f_cut,  psd_dx_cut,  \"DX Tagliato/Finestrato\", \"darkred\")\n",
    "    ]\n",
    "\n",
    "    for i, (f, p, titolo, colore) in enumerate(dati_plot):\n",
